      "name": "Extract from File"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\n\nRules:\n- Name: Title Case (Manoj K)\n- Email: if invalid set INVALID_EMAIL\n- Phone: if less than 10 digits set MISSING\n- Course: only Python or Machine Learning or Data Science\n- Fee_Paid: yes/YES = true, no/NO = false\n- City: Title Case, empty = UNKNOWN\n- Enrolled_Date: convert to YYYY-MM-DD\n\nReturn ONLY raw JSON. No explanation. No markdown.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        32,
        -48
      ],
      "id": "c9dfd04c-6a99-44a9-a162-3b5a238d1264",
      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -48,
        160
      ],
      "id": "9fbb2b56-b007-4958-ada2-d51ecf5d5158",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "ND0N0FewHxuYjV7l",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst results = [];\n\nfor (const item of items) {\n  try {\n    let rawData = item.json;\n\n    // Step 1: Extract JSON string from AI output\n    if (typeof rawData === \"object\" && rawData !== null) {\n      rawData =\n        rawData.output ??\n        rawData.text ??\n        rawData.response ??\n        rawData;\n    }\n\n    // Step 2: Parse JSON string\n    let student;\n\n    if (typeof rawData === \"string\") {\n      // Remove markdown code fences if present\n      rawData = rawData\n        .replace(/```json/gi, \"\")\n        .replace(/```/g, \"\")\n        .trim();\n\n      student = JSON.parse(rawData);\n    } else {\n      student = rawData;\n    }\n\n    // Step 3: Clean the fields\n    const clean = (value) =>\n      typeof value === \"string\" ? value.trim() : value;\n\n    student = {\n      Student_ID: clean(student.Student_ID),\n      Name: clean(student.Name),\n      Email: clean(student.Email)?.toLowerCase(),\n      Phone: String(student.Phone ?? \"\").replace(/\\D/g, \"\"),\n      Course: clean(student.Course),\n      Fee_Paid: student.Fee_Paid,\n      City: clean(student.City),\n      Enrolled_Date: clean(student.Enrolled_Date)\n    };\n\n    // Step 4: Validate email\n    const emailValid =\n      /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(student.Email || \"\");\n\n    // Step 5: Validate phone\n    const phoneValid = /^[6-9]\\d{9}$/.test(student.Phone);\n\n    // Step 6: Validate date\n    const dateValid = (() => {\n      if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(student.Enrolled_Date || \"\")) {\n        return false;\n      }\n\n      const date = new Date(student.Enrolled_Date + \"T00:00:00Z\");\n\n      return !isNaN(date.getTime()) &&\n        date.toISOString().slice(0, 10) === student.Enrolled_Date;\n    })();\n\n    // Step 7: Identify errors\n    const errors = [];\n\n    if (!student.Student_ID) errors.push(\"Missing Student ID\");\n    if (!student.Name) errors.push(\"Missing Name\");\n    if (!emailValid) errors.push(\"Invalid Email\");\n    if (!phoneValid) errors.push(\"Invalid Phone\");\n    if (!student.Course) errors.push(\"Missing Course\");\n    if (typeof student.Fee_Paid !== \"boolean\") {\n      errors.push(\"Invalid Fee Paid value\");\n    }\n    if (!student.City) errors.push(\"Missing City\");\n    if (!dateValid) errors.push(\"Invalid Enrolled Date\");\n\n    // Step 8: Return cleaned data\n    results.push({\n      json: {\n        ...student,\n        Email_Valid: emailValid,\n        Phone_Valid: phoneValid,\n        Date_Valid: dateValid,\n        Data_Status: errors.length === 0 ? \"Valid\" : \"Invalid\",\n        Error_Details: errors\n      }\n    });\n\n  } catch (error) {\n    // Handle parsing errors without stopping other records\n    results.push({\n      json: {\n        Data_Status: \"Parsing Failed\",\n        Error_Details: [error.message]\n      }\n    });\n  }\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
